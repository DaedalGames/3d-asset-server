{
  "name": "3d-asset-server",
  "version": "0.1.0",
  "description": "Unified search + download gateway (HTTP API and MCP server) for free and paid 3D assets, textures, materials and HDRIs.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://3d.shep.bot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arielshad/3d-asset-server.git"
  },
  "bugs": {
    "url": "https://github.com/arielshad/3d-asset-server/issues"
  },
  "keywords": [
    "3d",
    "3d-assets",
    "gltf",
    "pbr",
    "textures",
    "hdri",
    "polyhaven",
    "ambientcg",
    "kenney",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "cli",
    "game-assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "3d-asset-server": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/web/og",
    "npm-shrinkwrap.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/og/fonts','dist/og/fonts',{recursive:true})\"",
    "build:web": "node scripts/export-site-data.mjs && npm --prefix web run build && node -e \"require('fs').rmSync('dist/web',{recursive:true,force:true});require('fs').cpSync('web/dist','dist/web',{recursive:true})\"",
    "dev": "tsx watch src/cli.ts serve",
    "start": "node dist/cli.js serve",
    "mcp": "node dist/cli.js mcp",
    "typecheck": "tsc --noEmit && npm --prefix web run check",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run test/live"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@resvg/resvg-js": "^2.6.2",
    "cheerio": "^1.2.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "lru-cache": "^11.5.3",
    "mmdb-lib": "^3.0.3",
    "prom-client": "^15.1.3",
    "satori": "0.35.0",
    "sharp": "^0.34.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
